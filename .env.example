# ==========================================
# Configuration de développement (Exemple)
# ==========================================

# Mode débogage (True en dev, False en production)
DEBUG=True

# Clé secrète Django
SECRET_KEY=django-insecure-dev-secret-key-change-in-production

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Base de données :
# - Hors Docker (tests rapides) : sqlite:///db.sqlite3
# - Sous Docker (ou Postgres local) : postgres://pants_user:pants_password@db:5432/pants_db
DATABASE_URL=sqlite:///db.sqlite3

# Cache :
# - Hors Docker : locmemcache://
# - Sous Docker : redis://redis:6379/1
REDIS_URL=locmemcache://
