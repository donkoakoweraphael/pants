# ==========================================
# Configuration de développement (Exemple)
# Copiez ce fichier vers .env pour l'utiliser
# ==========================================

# Mode débogage (True en dev, False en production)
DEBUG=True

# Clé secrète Django
SECRET_KEY=django-insecure-dev-secret-key-change-in-production

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Base de données PostgreSQL (utilisée par Docker)
DATABASE_URL=postgres://pants_user:pants_password@db:5432/pants_db

# Cache Redis (utilisé pour les permissions et sessions)
REDIS_URL=redis://redis:6379/1
