# ==========================================
# Configuration de développement (Exemple)
# ==========================================

# Mode débogage (True en dev, False en production)
DEBUG=True

# Clé secrète Django
SECRET_KEY=django-insecure-dev-secret-key-change-in-production

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Paramètres PostgreSQL (utilisés à la fois par le conteneur db et web)
POSTGRES_DB=pants_db
POSTGRES_USER=pants_user
POSTGRES_PASSWORD=pants_password
POSTGRES_PORT=5432

# Paramètres Redis
REDIS_PORT=6379

# Base de données pour exécution directe hors Docker (tests locaux rapides)
# Hors Docker : sqlite:///db.sqlite3
# Sous Docker : calculé automatiquement depuis les variables POSTGRES_*
DATABASE_URL=sqlite:///db.sqlite3

# Cache pour exécution directe hors Docker
REDIS_URL=locmemcache://
